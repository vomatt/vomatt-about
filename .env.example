# Copy to .env.local for local development. On Vercel, set the same keys under
# Project → Settings → Environment Variables.

# ── Sanity (same project and dataset as vomatt-web; Studio lives in vomatt-admin)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ── vomatt-api (the contact form posts to /api/contact) ─────────────────────
# Origin only: no path, no trailing slash
API_URL=http://localhost:8080
# Same value as the API's CLIENT_IP_SECRET (≥32 characters). Lets the API rate-limit contact messages
# per visitor IP; unset, every visitor shares this server's IP there
CLIENT_IP_SECRET=

# ── Site ─────────────────────────────────────────────────────────────────────
# Public origin of this site, no trailing slash. Required: metadata and canonical URLs use it.
SITE_URL=http://localhost:3004
# vomatt-web's origin, no trailing slash. Open vomatt and relative links in Sanity (/explore) go there
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Shared with vomatt-admin's invalidate-tags Sanity Function (POST /api/revalidate). Production only
# SANITY_REVALIDATE_SECRET=
