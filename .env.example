# Copy to .env.local for local development. On Vercel, set the same keys under
# Project → Settings → Environment Variables.

# ── Sanity (same project and dataset as vomatt-web; Studio lives in vomatt-admin)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ── Site ─────────────────────────────────────────────────────────────────────
# Public origin of this site, no trailing slash. Required: metadata and canonical URLs use it.
SITE_URL=http://localhost:3004
